          "line": 25,
          "text": "signals{1}(1).overlap = 0.85;"
        },
        {
          "line": 31,
          "text": "cfg.filterchoices = [0.01,0.1,1,10];"
        },
        {
          "line": 33,
          "text": "result.filter = [];"
        },
        {
          "line": 48,
          "text": "for filt = cfg.filterchoices"
        },
        {
          "line": 55,
          "text": "EEG = pop_eegfiltnew(EEG_raw,filt,[]);"
        },
        {
          "line": 58,
          "text": "timelimits = [-0.8,1];"
        },
        {
          "line": 59,
          "text": "EEG = uf_timeexpandDesignmat(EEG,'timelimits',timelimits,'method','full','timeexpandparam',7);"
        },
        {
          "line": 74,
          "text": "result.filter(end+1) = filt;"
        },
        {
          "line": 79,
          "text": "tmp = num2cell(cfg.filterchoices);"
        },
        {
          "line": 86,
          "text": "g = gramm('x',ufresult.times,'y',result.betas(:,:,1),'color',result.filter);"
        },
        {
          "line": 91,
