+        mappings.append({"source_cell_index": index, "source_arm": source["arm"],
+                         "participant_key": source["participant_key"], "K": source["K"],
+                         "source_seed": source["source_seed"], "target_seed": source["target_seed"],
+                         "controls": matched})
+    return mappings
