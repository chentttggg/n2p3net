+    def project(self, X):
+        X = np.asarray(X, dtype=np.float64)
+        if X.ndim != 3 or X.shape[2] != self.matrix.shape[0] or not np.isfinite(X).all():
+            raise ValueError("temporal projection requires finite aligned (N,C,T) input")
+        return X @ self.matrix
