+    digest = hashlib.sha256()
+    digest.update(json.dumps({"dtype": array.dtype.str, "shape": list(array.shape)},
+                             sort_keys=True, separators=(",", ":")).encode("utf-8"))
+    digest.update(memoryview(array).cast("B"))
+    return digest.hexdigest()
