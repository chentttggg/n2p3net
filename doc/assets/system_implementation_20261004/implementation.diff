+    with pytest.raises(ValueError, match="integrity"):
+        model.score(record.samples, record.onsets, np.eye(2)[record.target_mask],
+                    operator_identity="raw", sfreq=10., channels=("Cz",), candidate_ids=("a", "b"), record_id="cal")
+    with pytest.raises(ValueError, match="integrity"):
