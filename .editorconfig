# Git preserves bytes; editors write LF for new or deliberately edited text.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Original evidence is read only; do not rewrite it on save.
[{doc/assets/**,frozen/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
